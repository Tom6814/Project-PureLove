# Supabase project settings (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Modern publishable key (or legacy anon key)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Service role key — 仅服务端使用，用于每日收藏夹同步任务（可访问所有用户数据，切勿暴露到前端）
# 从 Supabase Dashboard → Settings → API → Service Role Key 获取
SUPABASE_SERVICE_ROLE_KEY=
